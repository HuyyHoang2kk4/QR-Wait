# ==============================================================================
# QR-Wait Environment Variables Template
# Copy file nay thanh ".env" (khong commit .env len Git) va dien thong tin cua ban
# ==============================================================================

# --- PostgreSQL (Local pgAdmin 4 / Supabase Cloud) ---
DB_URL=jdbc:postgresql://localhost:5432/qr_wait
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# --- JWT Security (Toi thieu 32 ky tu ngau nhien) ---
JWT_SECRET=qrwait-dev-secret-key-please-change-in-production-min-32-chars

# --- Google OAuth2 SSO (Tuy chon khi test Google Login) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- CORS & Frontend URL ---
FRONTEND_URL=http://localhost:5173

# --- Cloud Object Storage cho Logo (Supabase Storage / Cloudinary) ---
STORAGE_BASE_URL=http://localhost:8080/uploads

# --- Frontend Vite Variables ---
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080/ws-qrwait
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
